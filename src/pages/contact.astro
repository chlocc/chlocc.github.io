---
import Base from "../layouts/Base.astro";
// Replace with your Formspree endpoint, e.g. "https://formspree.io/f/abcdwxyz"
const FORMSPREE_ENDPOINT = "https://formspree.io/f/moevdjvy";
const configured = !FORMSPREE_ENDPOINT.includes("REPLACE_ME");
---
<Base title="Contact — Chloe C." description="Get in touch with Chloe C..">
  <header class="wrap pagehead">
    <span class="eyebrow">Contact</span>
    <h1>Get in touch</h1>
    <p class="lede">For writing, speaking, or anything at the intersection of law,
    finance and technology.</p>
  </header>

  <section class="wrap">
    <div class="contact">
      <div class="contact__direct">
        <span class="eyebrow">Direct</span>
        <ul class="links">
          <li><a href="mailto:lwc.chloe@outlook.com">lwc.chloe@outlook.com</a></li>
          <li><a href="https://www.linkedin.com/in/chloe-lok-wing-chan/" target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href="https://cryptophobiccryptophile.substack.com/" target="_blank" rel="noopener">Substack</a></li>
          <li><a href="https://github.com/chlocc" target="_blank" rel="noopener">GitHub</a></li>
        </ul>
        <p class="muted loc">New York City, United States</p>
      </div>

      {configured ? (
        <form class="form" action={FORMSPREE_ENDPOINT} method="POST">
          <div class="row">
            <label>First name<input type="text" name="first_name" required autocomplete="given-name" /></label>
            <label>Last name<input type="text" name="last_name" autocomplete="family-name" /></label>
          </div>
          <label>Email<input type="email" name="email" required autocomplete="email" /></label>
          <label>Message<textarea name="message" rows="6" required></textarea></label>
          <button class="btn btn--accent" type="submit">Send</button>
        </form>
      ) : (
        <div class="reach">
          <p class="reach__lede">The quickest way to reach me is email — I read everything that
          arrives there.</p>
          <a class="btn btn--accent" href="mailto:lwc.chloe@outlook.com">Email me</a>
          <p class="reach__alt muted">Or find me on
            <a href="https://www.linkedin.com/in/chloe-lok-wing-chan/" target="_blank" rel="noopener">LinkedIn</a>,
            <a href="https://cryptophobiccryptophile.substack.com/" target="_blank" rel="noopener">Substack</a> and
            <a href="https://github.com/chlocc" target="_blank" rel="noopener">GitHub</a>.
          </p>
        </div>
      )}
    </div>
  </section>

  <style>
    .contact{display:grid;gap:clamp(2rem,5vw,4rem)}
    @media(min-width:880px){.contact{grid-template-columns:.8fr 1.2fr}}
    .links{list-style:none;padding:0;margin:0 0 1.5rem;display:grid;gap:.8rem}
    .links a{text-decoration:none;color:var(--ink);border-bottom:1px solid var(--rule);padding-bottom:2px}
    .links a:hover{color:var(--accent);border-bottom-color:var(--accent)}
    .loc{font-size:.9rem}
    .form{display:grid;gap:1.1rem}
    .row{display:grid;gap:1.1rem}
    @media(min-width:560px){.row{grid-template-columns:1fr 1fr}}
    label{display:grid;gap:.45rem;font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
    input,textarea{font:inherit;font-size:1rem;color:var(--ink);background:var(--paper);border:1px solid var(--rule);padding:.8rem .9rem;border-radius:0;width:100%}
    input:focus,textarea:focus{outline:none;border-color:var(--accent)}
    textarea{resize:vertical}
    .reach{border:1px solid var(--rule);background:var(--paper-2);padding:clamp(1.75rem,4vw,2.75rem)}
    .reach__lede{font-family:var(--serif);font-size:clamp(1.15rem,2vw,1.4rem);line-height:1.4;color:var(--ink);margin:0 0 1.75rem;max-width:34ch}
    .reach__alt{font-size:.92rem;margin:1.75rem 0 0}
    .reach__alt a{color:var(--accent);text-decoration:none;border-bottom:1px solid color-mix(in srgb,var(--accent) 35%,transparent)}
  </style>
</Base>
