---
import Base from "../layouts/Base.astro";
import publications from "../data/publications.json";
import builds from "../data/builds.json";
const featured = publications.filter(p => p.featured).concat(publications.filter(p => !p.featured)).slice(0, 3);
---
<Base title="Chloe Chan — Law, Finance & Technology">

  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__text">
        <span class="eyebrow">Law · Finance · Technology</span>
        <h1>Chloe Chan</h1>
        <p class="lede">
          Hong Kong&ndash;trained lawyer, Harvard Law LL.M., now a law clerk pending admission
          in the US. I write on digital asset regulation and build small tools that make it
          legible.
        </p>
        <div class="hero__cta">
          <a class="btn btn--accent" href="/writing/">Read the writing</a>
          <a class="btn" href="/builds/">See what I build</a>
        </div>
      </div>
      <figure class="hero__portrait">
        <img src="/img/portrait-chloe.png" alt="Chloe Lok Wing Chan" width="900" height="1120" />
      </figure>
    </div>
  </section>

  <section class="section section--tint quote-band">
    <div class="wrap narrow">
      <blockquote>
        <p>It is not the strongest of the species that survives, nor the most intelligent that
        survives. It is the one that is able best to adapt and adjust to the changing
        environment in which it finds itself.</p>
        <cite>Charles Darwin</cite>
      </blockquote>
    </div>
  </section>

  <section class="section">
    <div class="wrap about">
      <div class="about__label"><span class="eyebrow">About</span></div>
      <div class="about__body prose">
        <p>I have always taken the road less travelled.</p>
        <p>
          I am a <strong>law clerk (pending admission)</strong> at a U.S. law firm, and a
          Hong Kong&ndash;trained lawyer. I am a crypto native, drawn to the policy and
          regulatory questions around AI, blockchain and digital assets.
        </p>
        <p>
          Before Harvard, I was a <strong>Judicial Assistant at the Hong Kong Court of Final
          Appeal</strong>, and a barrister trainee specialising in corporate and commercial
          litigation. But my greater passion lies in entrepreneurship, technology and crypto
          regulation &mdash; I co-founded <a href="/projects/litex/">Litex</a>, Hong Kong&rsquo;s
          first LegalTech start-up, which used natural language processing to perform data
          extraction and judgment prediction.
        </p>
        <p>
          At Harvard I was Director of the MIT Investment Conference and an organiser of the
          HLS Blockchain and FinTech Annual Conference. I hold an <strong>LL.M. from Harvard
          Law School</strong>, a Postgraduate Certificate in Laws, and a double degree in Social
          Sciences (Government and Laws) and Laws from the University of Hong Kong, where I
          graduated with double first-class honours.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <header class="sec-head">
        <div>
          <span class="eyebrow">Insights &amp; Articles</span>
          <h2>Writing on regulation and markets</h2>
        </div>
        <a class="sec-head__link" href="/writing/">All writing →</a>
      </header>
      <div class="grid grid--3 pubs">
        {featured.map(p => (
          <article class="pub">
            <a href={p.href} class="pub__link" target={p.href.startsWith("http") ? "_blank" : undefined} rel={p.href.startsWith("http") ? "noopener" : undefined}>
              <div class="pub__img"><img src={p.image} alt="" loading="lazy" /></div>
              <p class="pub__meta">{p.outlet} · {p.date}</p>
              <h3 class="pub__title">{p.title}</h3>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <header class="sec-head">
        <div>
          <span class="eyebrow">Ventures</span>
          <h2>Things I have founded</h2>
        </div>
        <a class="sec-head__link" href="/projects/">Both ventures →</a>
      </header>
      <div class="grid grid--2">
        <a class="vcard" href="/projects/litex/">
          <span class="vcard__tag">LegalTech</span>
          <h3>Litex</h3>
          <p>Hong Kong's first LegalTech start-up using NLP for data extraction and judgment
          prediction in personal injury cases. Incubated at HKSTP and the HKAI Lab.</p>
          <span class="vcard__go">Read the story →</span>
        </a>
        <a class="vcard" href="/projects/liblit/">
          <span class="vcard__tag">FinTech</span>
          <h3>LibLit</h3>
          <p>Unlocking capital for underfunded impact litigation through innovative financing.
          Supported by the Harvard Innovation Labs.</p>
          <span class="vcard__go">Read the story →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <header class="sec-head">
        <div>
          <span class="eyebrow">Builds</span>
          <h2>Tools I ship on the side</h2>
        </div>
        <a class="sec-head__link" href="/builds/">All builds →</a>
      </header>
      <ul class="buildlist">
        {builds.map(b => (
          <li>
            <a href={b.href} target="_blank" rel="noopener">
              <span class="buildlist__name">{b.name}</span>
              <span class="buildlist__tag">{b.tagline}</span>
              <span class="buildlist__go">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <style>
    .hero{padding-block:clamp(2.5rem,6vw,5.5rem)}
    .hero__in{display:grid;gap:clamp(2rem,5vw,4rem);align-items:center}
    @media(min-width:880px){.hero__in{grid-template-columns:1.15fr .85fr}}
    .hero__text h1{margin-bottom:1.6rem}
    .hero__cta{display:flex;gap:.9rem;flex-wrap:wrap;margin-top:2.2rem}
    .hero__portrait{margin:0}
    .hero__portrait img{width:100%;height:auto;border-radius:2px;filter:saturate(.92)}

    .quote-band blockquote{margin:0;text-align:center}
    .quote-band p{font-family:var(--serif);font-size:clamp(1.25rem,2.4vw,1.85rem);line-height:1.42;font-style:italic;color:var(--ink)}
    .quote-band cite{display:block;margin-top:1.4rem;font-style:normal;font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}

    .about{display:grid;gap:1.5rem}
    @media(min-width:880px){.about{grid-template-columns:200px 1fr;gap:3rem}}
    .about__body{font-size:1.08rem;max-width:62ch}

    .sec-head{display:flex;justify-content:space-between;align-items:end;gap:1.5rem;margin-bottom:clamp(2rem,4vw,3rem);flex-wrap:wrap}
    .sec-head__link{font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;color:var(--accent);white-space:nowrap;padding-bottom:.3rem;border-bottom:1px solid color-mix(in srgb,var(--accent) 40%,transparent)}

    .pub__link{text-decoration:none;display:block}
    .pub__img{aspect-ratio:3/2;overflow:hidden;background:var(--paper-3);margin-bottom:1rem}
    .pub__img img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}
    .pub__link:hover .pub__img img{transform:scale(1.04)}
    .pub__meta{font-size:.74rem;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin:0 0 .5rem}
    .pub__title{font-size:1.15rem;line-height:1.3}
    .pub__link:hover .pub__title{color:var(--accent)}

    .vcard{display:block;text-decoration:none;background:var(--paper);border:1px solid var(--rule);padding:clamp(1.75rem,3vw,2.5rem);transition:border-color .2s,transform .2s}
    .vcard:hover{border-color:var(--accent);transform:translateY(-2px)}
    .vcard__tag{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}
    .vcard h3{margin:.7rem 0 .8rem;font-size:1.8rem}
    .vcard p{color:var(--ink-soft);font-size:.98rem}
    .vcard__go{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-top:1.2rem;display:inline-block}

    .buildlist{list-style:none;margin:0;padding:0;border-top:1px solid var(--rule)}
    .buildlist li{border-bottom:1px solid var(--rule)}
    .buildlist a{display:grid;grid-template-columns:1fr auto;gap:.3rem 1.5rem;align-items:baseline;padding:1.4rem .25rem;text-decoration:none}
    @media(min-width:760px){.buildlist a{grid-template-columns:minmax(0,15rem) 1fr auto}}
    .buildlist a:hover{background:color-mix(in srgb,var(--accent) 4%,transparent)}
    .buildlist__name{font-family:var(--serif);font-size:1.25rem}
    .buildlist__tag{color:var(--muted);font-size:.95rem}
    .buildlist__go{color:var(--accent)}
  </style>
</Base>
