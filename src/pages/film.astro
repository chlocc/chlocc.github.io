---
import Base from "../layouts/Base.astro";
---
<Base title="Film — Chloe C." description="Directed and produced an official video introducing the role of a judicial assistant at the Hong Kong Court of Final Appeal.">
  <header class="wrap pagehead">
    <span class="eyebrow">Filmography</span>
    <h1>Film &amp; photography</h1>
  </header>

  <section class="wrap">
    <article class="feature">
      <div class="feature__img"><img src="/img/film-jda-class.jpg" alt="Judicial Assistants, Hong Kong Court of Final Appeal" /></div>
      <div class="feature__body">
        <span class="eyebrow">Director &amp; producer</span>
        <h2>The Judicial Assistant Scheme</h2>
        <p>Directed and produced an official video introducing the role of a judicial assistant
        at the Hong Kong Court of Final Appeal.</p>
        <a class="btn btn--accent" href="https://www.hkcfa.hk/en/about/who/jda/introduction/index.html" target="_blank" rel="noopener">Watch on hkcfa.hk</a>
      </div>
    </article>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="soon">
        <span class="eyebrow">Photography</span>
        <p class="soon__text">Stay tuned.</p>
      </div>
    </div>
  </section>

  <style>
    .feature{display:grid;gap:clamp(1.5rem,4vw,3.5rem);align-items:center}
    @media(min-width:880px){.feature{grid-template-columns:1.15fr .85fr}}
    .feature__img{background:var(--paper-3)}
    .feature__img img{width:100%;height:auto}
    .feature__body h2{margin-bottom:1rem;font-size:clamp(1.7rem,2.8vw,2.3rem)}
    .feature__body p{color:var(--ink-soft);margin-bottom:1.8rem}
    .soon{border:1px dashed var(--rule);padding:clamp(2.5rem,6vw,4.5rem);text-align:center}
    .soon__text{font-family:var(--serif);font-size:1.6rem;color:var(--muted);margin:0}
  </style>
</Base>
